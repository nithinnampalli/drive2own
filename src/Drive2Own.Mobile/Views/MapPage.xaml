<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="Drive2Own.Mobile.Views.MapPage"
             Title="Map">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Map -->
        <maps:Map Grid.Row="1" x:Name="MainMap" IsShowingUser="True"/>

        <!-- Top Toolbar -->
        <Frame Grid.Row="0" BackgroundColor="White" Padding="12" HasShadow="True">
            <HorizontalStackLayout Spacing="8">
                <Button Text="📍 Add Pin" Command="{Binding EnablePinModeCommand}" BackgroundColor="#e2e8f0" TextColor="#2d3748" CornerRadius="8" HeightRequest="36" FontSize="13"/>
                <Button Text="🔄 Refresh" Command="{Binding LoadPinsCommand}" BackgroundColor="#e2e8f0" TextColor="#2d3748" CornerRadius="8" HeightRequest="36" FontSize="13"/>
            </HorizontalStackLayout>
        </Frame>

        <!-- Add Pin Panel -->
        <Frame Grid.Row="2" BackgroundColor="White" Padding="16" HasShadow="True">
            <VerticalStackLayout Spacing="8">
                <Label Text="Add a pin at tapped location:" FontSize="13" TextColor="#718096"/>
                <Entry Placeholder="Pin title *" Text="{Binding NewPinTitle}" FontSize="14"/>
                <Entry Placeholder="Description (optional)" Text="{Binding NewPinDescription}" FontSize="14"/>
                <Label Text="{Binding NewPinLatitude, StringFormat='Lat: {0:F6}'}" FontSize="12" TextColor="#718096"/>
                <Label Text="{Binding NewPinLongitude, StringFormat='Lon: {0:F6}'}" FontSize="12" TextColor="#718096"/>
                <Button Text="Add Pin" Command="{Binding AddPinCommand}"
                        BackgroundColor="#4CAF50" TextColor="White" CornerRadius="8" HeightRequest="40"/>
            </VerticalStackLayout>
        </Frame>
    </Grid>

</ContentPage>
