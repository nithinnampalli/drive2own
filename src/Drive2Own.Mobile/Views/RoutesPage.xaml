<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Drive2Own.Mobile.Views.RoutesPage"
             Title="My Routes">

    <RefreshView Command="{Binding LoadRoutesCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Routes}" EmptyView="No routes yet. Start tracking!">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="12,6" CornerRadius="12" Padding="14" HasShadow="True" BackgroundColor="White">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0" Text="🚗" FontSize="28" VerticalOptions="Center" Margin="0,0,12,0"/>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16"/>
                                    <Label Text="{Binding TravelMode}" FontSize="12" TextColor="#718096"/>
                                    <Label Text="{Binding StartedAt, StringFormat='{0:MMM dd, yyyy}'}" FontSize="12" TextColor="#718096"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" HorizontalOptions="End">
                                    <Label Text="{Binding TotalDistanceMeters, StringFormat='{0:F0} m'}" FontSize="13" TextColor="#4CAF50" HorizontalOptions="End"/>
                                    <Label Text="{Binding IsCompleted, Converter={StaticResource BoolToCompletedConverter}}" FontSize="11" TextColor="#718096" HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>

                            <HorizontalStackLayout Spacing="8">
                                <Button Text="🔗 Share" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShareRouteCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#e2e8f0" TextColor="#2d3748" FontSize="12" CornerRadius="6" Padding="8,4" HeightRequest="32"/>
                                <Button Text="🗑️ Delete" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteRouteCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#fee2e2" TextColor="#b91c1c" FontSize="12" CornerRadius="6" Padding="8,4" HeightRequest="32"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
